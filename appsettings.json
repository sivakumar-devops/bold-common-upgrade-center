{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UpgradeCenter": {
    "ProductName": "Bold Upgrade Center",
    "DeploymentMode": "Auto",
    "BiReleaseVersionsApiUrl": "https://releases.boldbi.com/version/json",
    "ReportsReleaseVersionsApiUrl": "https://releases.boldbi.com/reports/version/json",
    "Services": {
      "IdpApi": "",
      "Ums": ""
    },
    "Authentication": {
      "LoginPath": "/accounts/login",
      "SessionValidationPath": "/upgrade-center/auth/session",
      "AdminValidationPath": "/upgrade-center/authorization/admin",
      "IdpPublicUrlOverride": "",
      "AllowedForwardedPrefixes": [
        "/upgrade-center",
        "/platform",
        "/platform/upgrade-center"
      ]
    },
    "Playwright": {
      "UseKubernetesJob": false,
      "JobTimeoutSeconds": 9000,
      "CleanupJobTimeoutSeconds": 900,
      "JobPollSeconds": 5,
      "BackoffLimit": 0,
      "CompletedJobTtlSeconds": 3600,
      "WorkerCount": 1,
      "JobCpuRequest": "1",
      "JobCpuLimit": "2",
      "JobMemoryRequest": "2Gi",
      "JobMemoryLimit": "4Gi",
      "SharedStateVolumeEnabled": true,
      "SharedStateStorageClassName": "",
      "SharedStateStorageSize": "1Gi",
      "SharedStateAccessMode": "ReadWriteOnce",
      "SharedStateMountPath": "/app/playwright-shared-state",
      "SharedStateFsGroup": 1001,
      "PassRateThreshold": "100",
      "ReportPath": "/app/pre-upgrade-test-results/reports.html",
      "PreJunitReportPath": "/app/pre-upgrade-test-results/junit-report.xml",
      "PostJunitReportPath": "/app/post-upgrade-test-results/junit-report.xml",
      "PreHtmlReportPath": "/app/pre-upgrade-test-results/reports.html",
      "PostHtmlReportPath": "/app/post-upgrade-test-results/reports.html",
      "PreHtmlReportDirectory": "/app/pre-upgrade-test-results",
      "PostHtmlReportDirectory": "/app/post-upgrade-test-results",
      "ReportStoragePath": "App_Data/PlaywrightReports",
      "ReportUploadBaseUrl": "http://bold-upgrade-center/upgrade-center/api/playwright-reports",
      "ResultUploadBaseUrl": "http://bold-upgrade-center/upgrade-center/api/playwright-results",
      "ReportRetentionJobCount": 7
    },
    "ProductHealthCheck": {
      "Enabled": true,
      "TimeoutSeconds": 300,
      "PollSeconds": 10,
      "RequestTimeoutSeconds": 10
    },
    "Kubernetes": {
      "SkipTlsVerify": false,
      "AllowSkipTlsVerifyForLocalDevelopment": false,
      "CertificateAuthorityPath": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
      "AllowedImageRepositories": [],
      "AllowedImageRegistryHosts": []
    }
  },
  "AllowedHosts": "*"
}
